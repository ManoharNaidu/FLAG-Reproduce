# Copy to .env and fill in. .env is git-ignored - NEVER commit real tokens.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# HuggingFace. Required only for the FLAG LLM stages.
# google/gemma-2-9b-it is a GATED repository: you must accept Google's licence
# on the model page, then create a read token.
#   https://huggingface.co/google/gemma-2-9b-it
#   https://huggingface.co/settings/tokens
# NOT needed for: dataset preprocessing, baseline GNN training, or the tests.
# ---------------------------------------------------------------------------
HF_TOKEN=
HF_HOME=

# The FLAG paper writes "Gemma-9b-it", which is not a valid HuggingFace id.
# The official code hardcodes the bare directory name "gemma-2-9b-it".
# The resolved id is below. See research/paper_notes.md section 3.1.
FLAG_LLM_MODEL=google/gemma-2-9b-it

# Text encoder. The paper says only "Sentence-BERT"; the official code pins this
# exact checkpoint (384-dim), corroborated by DualGNN's hardcoded Linear(384, ...).
FLAG_TEXT_ENCODER=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Hardware
# ---------------------------------------------------------------------------
# cpu | cuda | cuda:0 ...   Never hardcode a device in source.
FLAG_DEVICE=cpu

# ---------------------------------------------------------------------------
# Paths. Defaults are fine; override to keep large data off this drive.
# ---------------------------------------------------------------------------
FLAG_DATA_DIR=./data
FLAG_CACHE_DIR=./cache
FLAG_RESULTS_DIR=./results

# ---------------------------------------------------------------------------
# Optional: Weights & Biases. DGA-GNN's official configs enable wandb by default
# (nowandb: False), which will prompt for a login on a fresh run.
# ---------------------------------------------------------------------------
WANDB_API_KEY=
WANDB_MODE=offline
