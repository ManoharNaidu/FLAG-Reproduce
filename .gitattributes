# Git LFS. Only our own run outputs go through LFS -- see .gitignore's
# "Generated artefacts" section for what's committed at all, and why model
# weights / venvs / third-party data & methods are excluded outright rather
# than routed through LFS.
cache/llm/**/*.json filter=lfs diff=lfs merge=lfs -text
checkpoints/**/*.pt filter=lfs diff=lfs merge=lfs -text
checkpoints/**/*.pth filter=lfs diff=lfs merge=lfs -text
checkpoints/**/*.ckpt filter=lfs diff=lfs merge=lfs -text
checkpoints/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
